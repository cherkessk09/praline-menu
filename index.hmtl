<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Praline — Меню</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FBF3E3; --card:#FFFDF8; --ink:#3A2A1E; --muted:#8A6F55;
  --accent:#A0522D; --line:#E4D3B8; --tabActive:#A0522D; --tabInactive:#EFE1C6;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1E1712; --card:#2A2019; --ink:#F1E4D0; --muted:#C7A883;
    --accent:#D89A66; --line:#3E2F22; --tabActive:#D89A66; --tabInactive:#332619;
  }
}
:root[data-theme="dark"]{
  --bg:#1E1712; --card:#2A2019; --ink:#F1E4D0; --muted:#C7A883;
  --accent:#D89A66; --line:#3E2F22; --tabActive:#D89A66; --tabInactive:#332619;
}
*{box-sizing:border-box;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased;
}
header{
  padding:28px 18px 14px; text-align:center;
  border-bottom:1px solid var(--line);
}
header h1{
  font-family:'Playfair Display',serif; font-size:2rem; margin:0 0 4px;
  letter-spacing:1px; color:var(--accent);
}
header p{margin:0; color:var(--muted); font-size:.9rem;}
.tabs{
  display:flex; overflow-x:auto; gap:8px; padding:14px 12px;
  position:sticky; top:env(safe-area-inset-top,0px); background:var(--bg);
  z-index:10; border-bottom:1px solid var(--line); -webkit-overflow-scrolling:touch;
}
.tabs::-webkit-scrollbar{display:none;}
.tab{
  flex:0 0 auto; padding:8px 16px; border-radius:20px; font-size:.85rem;
  font-weight:600; background:var(--tabInactive); color:var(--ink);
  cursor:pointer; white-space:nowrap; border:none;
}
.tab.active{background:var(--tabActive); color:#fff;}
main{max-width:760px; margin:0 auto; padding:8px 16px 60px;}
.section{display:none;}
.section.active{display:block; animation:fade .25s ease;}
@keyframes fade{from{opacity:0}to{opacity:1}}
.group{margin-bottom:26px;}
.group h2{
  font-family:'Playfair Display',serif; font-size:1.2rem; color:var(--accent);
  border-bottom:2px solid var(--line); padding-bottom:6px; margin-bottom:10px;
}
.item{
  display:flex; justify-content:space-between; align-items:baseline;
  gap:10px; padding:7px 0; border-bottom:1px dashed var(--line);
}
.item .name{font-weight:500; font-size:.95rem;}
.item .desc{display:block; font-size:.75rem; color:var(--muted); font-weight:400;}
.item .price{font-weight:600; white-space:nowrap; font-size:.95rem;}
footer{text-align:center; padding:20px; color:var(--muted); font-size:.8rem;}
</style>
</head>
<body>
<header>
  <h1>PRALINÉ</h1>
  <p>Кафе · Кондитерская · Первомайская улица, 8, Черкесск</p>
</header>

<div class="tabs" id="tabs"></div>
<main id="main"></main>
<footer>+7 (928) 838-33-63</footer>

<script>
const data = {
"Напитки": {
 "Лимонады 0,5/1л":[["Мохито классика","310/520Р"],["Мохито клубника","310/520Р"],["Лайм-малина","310/520Р"],["Манго-маракуя","340/580Р"],["Киви-лайм","310/520Р"],["Ананасовый","340/580Р"],["Гранат-черника","340/580Р"],["Арбузный (сезонный)","350Р"],["Щавелевый (сезонный)","350Р"]],
 "Смузи 0,3":[["Малиновый","380Р","молоко"],["Зелёный","350Р","сок"],["Спелые ягоды","350Р","молоко/сок"]],
 "Милкшейки 0,5":[["Ванильный","350Р"],["Клубничный","350Р"],["Шоколадный","350Р"],["Орео","370Р"],["Баунти","380Р"],["Сникерс","380Р"]],
 "Фреши 0,3":[["Апельсин","350Р"],["Яблоко-апельсин","350Р"],["Яблоко","340Р"],["Яблоко-морковь","340Р"],["Грейпфрут","370Р"],["Грейпфрут-апельсин","360Р"]],
 "Соки 0,3/1л":[["В ассортименте","150/350Р"],["Яблоко","—"],["Апельсин","—"],["Гранат","—"],["Ананас","—"],["Вишня","—"],["Мультифрукт","—"]],
 "Напитки в стекле":[["Кола","160Р"],["Вода","150Р"],["Вода минеральная","180Р"]],
 "Мороженое (шарик)":[["Ваниль","120Р"],["Шоколад","120Р"],["Клубника","120Р"]]
},
"Кофе и чай": {
 "Классика 0,25/0,35":[["Эспрессо","180Р"],["Допио","200Р"],["Американо","210Р"],["Лунго","200Р"],["Варёный кофе","190/250Р"],["Флэт уайт","250Р"],["Капучино","260/290Р"],["Раф урбеч","350Р"],["Раф классический","270/310Р"],["Латте","240/280Р"],["Аффогато","320Р"]],
 "Холодный кофе 0,5":[["Айс латте","280Р"],["Айс раф","320Р"],["Фраппучино классика","350Р"],["Бамбл апельсин","330Р"],["Бамбл гранат","340Р"],["Бамбл вишня","330Р"],["Бамбл фреш","370Р"],["Эспрессо-тоник","300Р"],["Финико-банановый эспрессо","380Р"]],
 "Добавки":[["Сироп к кофе","30Р"],["Мёд","70Р"],["Орехи","50Р"],["Мята/лимон","40Р"]],
 "Чай домашний 0,3/0,5/1л":[["Медово-имбирный","210/320/500Р"],["Облепиха-апельсин","190/300/490Р"],["Красные ягоды","210/320/500Р"],["Клубника-лайм","190/300/490Р"],["Малина-имбирь","210/320/500Р"],["Манго-ананас","190/300/490Р"],["Малина-мята","190/300/490Р"],["Глинтвейн","210/320/500Р"],["Гранат-малина","210/320/500Р"],["Калмыцкий","170/250/350Р"]],
 "Чай листовой 0,3/0,5/1л":[["В ассортименте","190/300/410Р"],["Ассам","—"],["Зелёный с жасмином","—"],["Эрл грей","—"],["Восточная сказка","—"],["Сенча","—"],["Молочный улун","—"]],
 "Всё в шоколаде 0,25/0,35":[["Горячий шоколад","200/250Р"],["Замена молока: кокосовое/миндальное/банановое/безлактозное","+80/120Р"]]
},
"Завтраки": {
 "Завтраки":[["ПП сырники с маком","510Р","творог, рисовая мука, мак"],["Сырники ванильные","490Р"],["Панкейки с ягодами и мороженым","470Р","сезонные ягоды, молочный ганаш"],["Кукурузная каша","320Р","сезонные ягоды"],["Омлет-рулет с с/с семгой","610Р","шпинат, крем-сыр, огурец"],["Омлет с овощной шапочкой","490Р","авокадо, черри, огурец, крем-сыр"],["Комплексный завтрак «Praline»","510Р","лакумы, сыр домашний, сливочное масло, отварные яйца"],["Комплексный с курицей","490Р","омлет, курочка, черри, огурец"],["Комплексный с сосисками","620Р","глазунья, черри, огурец, сосиски, бейби картофель"],["Шакшука острая","470Р"],["Рисовая каша","330Р","сладкая/солёная, ягоды"],["Овсяная каша","330Р","сладкая/солёная, ягоды"]],
 "Круассаны":[["Круассан с джемом","230Р"],["Круассан пустой","180Р"],["Круассан с с/с семга и пашот","550Р"],["Круассан с курицей и страчателлой","450Р"]]
},
"Пицца и паста": {
 "Пиццы":[["4 сыра","620Р"],["Маргарита","490Р"],["Пепперони","650Р"],["С копчёной курочкой и грибами","680Р"],["Со страчателлой","720Р"],["По-аджарски","550Р"],["По-имеретински","550Р"],["Цезарь","670Р"],["Чикен фри","770Р"]],
 "Пасты":[["Спагетти в томатном соусе со страчателлой","620Р","томаты, базилик, страчателла"],["Спагетти карбонара с копчёной говядиной","550Р","лук, сливочный соус, яйцо"],["Паста с курицей и грибами","610Р","сливочный соус"],["Паста с лососем и цукини","670Р","сливочный соус"],["Паста с морепродуктами (том ям, острая)","590Р","креветки, мидии"],["Фузилли с креветками и песто","630Р","сливочный соус"]],
 "Супы":[["Чечевичный суп","430Р","овощная пассеровка, сливки, сухари"],["Грибной крем-суп","450Р","овощная пассеровка, сливки, сухари"],["Сырный крем-суп с курицей","450Р","овощная пассеровка, сливки, сухари, курочка"],["Тыквенный крем-суп","470Р","тыква, микс креветок, сливки"],["Суп-лапша с курочкой","370Р"],["Том ям с морепродуктами","720Р","креветки, мидии"],["Том ям с курицей и грибами","530Р"]],
 "Соусы":[["Цезарь","130Р"],["Сырный","130Р"],["Кетчуп","130Р"],["Ореховый","130Р"],["Кисло-сладкий","130Р"],["Кимчи","130Р"],["Майонез","100Р"],["Сметана","100Р"],["Дзадзики","150Р"],["Аджика","150Р"],["Шрирача","130Р"],["Грибной","150Р"]]
},
"Роллы": {
 "Классика":[["Фила классика","530Р"],["Фила креветка","570Р"],["Фила краб","550Р"],["Калифорния в кунжуте","490Р"],["Калифорния креветка","490Р"],["Калифорния chicken","470Р"],["Barbie ролл (авторский)","610Р"]],
 "Запечённые роллы":[["Эби с креветкой","430Р"],["Окинава с крабом","410Р"],["Киота с лососем","410Р"],["Фила хот","530Р"]],
 "Темпура роллы":[["Эби темпура (креветка)","510Р"],["Фила темпура (лосось)","530Р"],["Цезарь темпура (курочка)","450Р"],["Айсберг темпура (краб)","510Р"],["Сэндвич ролл","430Р"]],
 "Сеты":[["Сет №1 PRALINE 40шт","2100Р","фила классика, калифорния в кунжуте, калифорния креветка, окинава, ролл с огурцом"],["Сет №2 запечённые 32шт","1800Р","фила hot, sanev.chicken, эби, окинава, сырные палочки (бонус)"],["Сет №3 темпура 36шт","1650Р","айсберг, эби, цезарь, сэндвич ролл, фила, креветки в кляре (бонус)"]]
},
"Горячее и закуски": {
 "Горячее":[["Куриная грудка рататуй и цукини","750Р","грибной соус, унаги соус"],["Жареные медальоны с картофелем бейби и киноа","950Р","прожарку уточняйте у официанта"],["Стейк миньон","980Р","гарнир пюре, прожарку уточняйте"],["Вареники с картошкой","450Р","обжаренный лук"],["Вареники с вишней","340Р","с сахаром и ягодами"],["Бургер с мраморной говядиной","790Р","котлета, чесночный соус, фри"],["Бургер с курицей","670Р","куриная грудка, чесночный соус, фри"],["Чизбургер","650Р"],["Мини-бургер с фри","530Р"],["Жареный лосось с рисом и шпинатом","990Р"],["Жаркое из вырезки","770Р","грибы, перец, кабачки, черри"],["Жаркое с курицей","590Р","грибы, перец, черри, кабачки"],["Жаркое ассорти","850Р","кхыйма, сушёная говядина"],["Бефстроганов","690Р","грибы, лук, вырезка, сливочный соус"],["Оладьи из кабачков","620Р","крем-сыр, с/с семга"]],
 "Закуски":[["Бышлакъ бишкирген","350Р"],["Фри с пармезаном","230Р","соус на выбор: кетчуп/сырный"],["Стрипсы","320Р","соус цезарь"],["Сэндвич клаб с курицей","630Р"],["Сэндвич с индейкой","450Р"],["Сэндвич с с/с семгой","550Р"],["Креветки в кляре","670Р","с фирменным соусом"],["Кесадилья с курицей","590Р"],["Кесадилья с вырезкой (острая)","690Р"],["Арбузная тарелка (сезонное блюдо!)","950Р","с сыром фета и ягодами"]],
 "Лодочки":[["4 сыра","310Р"],["Лодочка с лососем","550Р"],["Лодочка с курочкой","340Р"]]
},
"Салаты и гарниры": {
 "Салаты":[["ПП салат с креветками и авокадо","650Р","руккола, огурец, оливковое масло, авокадо"],["ПП зелёный с авокадо","510Р","микс, огурец, кабачки, оливки, маслины, перепелиные яйца"],["ПП салат с креветкой и киноа","470Р","пашот, картофель бейби, лимонная заправка, киноа"],["Цезарь с курицей","610Р"],["Цезарь с креветками","670Р"],["Цезарь с с/с семгой","690Р"],["Салат с хрустящими баклажанами","690Р"],["Овощной с базиликом и фетой","470Р"],["Салат с морепродуктами и томатами","650Р","страчателла, томаты, бейби картофель"],["Тёплый с мини-стейками","750Р","кунжутная заправка, кедровый орех"],["Овощной салатик","330Р","на выбор: сметана, майонез, оливковое масло"],["Салат со страчателлой и авокадо","530Р"],["Салат с хрустящим сыром","580Р"]],
 "Гарниры":[["Картофель бейби киноа","270Р"],["По-деревенски","230Р"],["Картофельное пюре","250Р"],["Рис со шпинатом","250Р"]]
}
};

const tabsEl = document.getElementById('tabs');
const mainEl = document.getElementById('main');
const cats = Object.keys(data);

cats.forEach((cat, i) => {
  const btn = document.createElement('button');
  btn.className = 'tab' + (i===0 ? ' active' : '');
  btn.textContent = cat;
  btn.onclick = () => showCat(cat);
  btn.dataset.cat = cat;
  tabsEl.appendChild(btn);

  const sec = document.createElement('section');
  sec.className = 'section' + (i===0 ? ' active' : '');
  sec.id = 'sec-' + i;
  sec.dataset.cat = cat;

  Object.entries(data[cat]).forEach(([groupName, items]) => {
    const g = document.createElement('div');
    g.className = 'group';
    g.innerHTML = '<h2>' + groupName + '</h2>';
    items.forEach(([name, price, desc]) => {
      const it = document.createElement('div');
      it.className = 'item';
      it.innerHTML = '<span class="name">' + name + (desc ? '<span class="desc">' + desc + '</span>' : '') + '</span><span class="price">' + price + '</span>';
      g.appendChild(it);
    });
    sec.appendChild(g);
  });
  mainEl.appendChild(sec);
});

function showCat(cat){
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.cat===cat));
  document.querySelectorAll('.section').forEach(s => s.classList.toggle('active', s.dataset.cat===cat));
  window.scrollTo({top:0, behavior:'smooth'});
}
</script>
</body>
</html>
